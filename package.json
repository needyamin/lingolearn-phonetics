{
  "name": "lingo-learn",
  "version": "2.0.0",
  "description": "LingoLearn - Pronunciation & Dictionary",
  "main": "src/main.js",
  "scripts": {
    "start": "electron .",
    "dist": "electron-builder",
    "dist:inno": "node scripts/build-inno.js",
    "dist:msix": "node scripts/build-msix.js",
    "dist:win": "node scripts/build-inno.js && node scripts/build-msix.js",
    "dist:linux": "electron-builder --linux",
    "dist:linux:docker": "docker build -f Dockerfile.linux-build -t tts-pronunciation-linux-builder . && docker run --rm -v \"%cd%/dist:/app/dist\" tts-pronunciation-linux-builder",
    "pack": "electron-packager . \"LingoLearn Phonetics\" --overwrite --platform=win32 --arch=x64 --icon=asset/icon.png --prune=true --out=release-builds"
  },
  "keywords": [],
  "author": "needyamin",
  "license": "ISC",
  "devDependencies": {
    "electron": "^28.0.0",
    "electron-builder": "^24.9.1",
    "electron-packager": "^17.1.2"
  },
  "dependencies": {
    "@huggingface/transformers": "^4.2.0",
    "electron-store": "^8.1.0",
    "electron-updater": "^6.1.0"
  },
  "build": {
    "appId": "com.needyamin.lingolearn",
    "productName": "LingoLearn Phonetics",
    "directories": {
      "output": "dist"
    },
    "publish": {
      "provider": "github",
      "owner": "needyamin",
      "repo": "lingoLearn-phonetics"
    },
    "win": {
      "target": [
        {
          "target": "nsis",
          "arch": ["x64"]
        },
        {
          "target": "portable",
          "arch": ["x64"]
        }
      ],
      "icon": "asset/icon.png",
      "sign": null,
      "forceCodeSigning": false,
      "signAndEditExecutable": false
    },
    "nsis": {
      "oneClick": true,
      "perMachine": false,
      "createDesktopShortcut": true,
      "createStartMenuShortcut": true,
      "shortcutName": "LingoLearn Phonetics",
      "differentialPackage": true,
      "artifactName": "LingoLearn Phonetics Setup ${version}.${ext}"
    },
    "files": [
      "src/**/*",
      "asset/**/*",
      "package.json"
    ],
    "asarUnpack": [
      "src/windows-asr.ps1",
      "node_modules/@huggingface/transformers/**",
      "node_modules/onnxruntime-web/**"
    ],
    "linux": {
      "target": "AppImage",
      "icon": "asset/icon.png",
      "category": "Education"
    },
    "appx": {
      "identityName": "needyamin.LingoLearnPhonetics",
      "publisher": "CN=Md. Yamin Hossain",
      "publisherDisplayName": "Md. Yamin Hossain",
      "applicationId": "LingoLearnPhonetics",
      "displayName": "LingoLearn Phonetics",
      "languages": ["en-US"]
    }
  },
  "allowScripts": {
    "electron@28.3.3": true
  }
}
