{
  "name": "lingo-learn",
  "version": "2.1.0",
  "description": "LingoLearn - Pronunciation & Dictionary",
  "main": "src/main.js",
  "scripts": {
    "start": "electron .",
    "test": "node scripts/qa-practice-align.js && node scripts/qa-practice-dom.js",
    "test:align": "node scripts/qa-practice-align.js",
    "test:dom": "node scripts/qa-practice-dom.js",
    "dist": "electron-builder",
    "dist:inno": "node scripts/build-inno.js",
    "dist:msix": "node scripts/build-msix.js",
    "dist:win": "node scripts/build-inno.js && node scripts/build-msix.js",
    "dist:linux": "electron-builder --linux",
    "dist:linux:docker": "node scripts/build-linux-docker.js",
    "pack": "electron-packager . \"LingoLearn Phonetics\" --overwrite --platform=win32 --arch=x64 --icon=asset/icon.png --prune=true --out=release-builds"
  },
  "keywords": [],
  "author": "needyamin",
  "license": "ISC",
  "devDependencies": {
    "electron": "^28.0.0",
    "electron-builder": "^24.9.1",
    "electron-packager": "^17.1.2",
    "rcedit": "^5.0.2"
  },
  "dependencies": {
    "@huggingface/transformers": "^4.2.0",
    "electron-store": "^8.1.0",
    "electron-updater": "^6.1.0"
  },
  "build": {
    "appId": "com.needyamin.lingolearn",
    "productName": "LingoLearn Phonetics",
    "afterPack": "scripts/after-pack.js",
    "directories": {
      "output": "dist"
    },
    "publish": {
      "provider": "github",
      "owner": "needyamin",
      "repo": "lingoLearn-phonetics"
    },
    "win": {
      "target": [
        {
          "target": "nsis",
          "arch": [
            "x64"
          ]
        },
        {
          "target": "portable",
          "arch": [
            "x64"
          ]
        }
      ],
      "icon": "asset/icon.png",
      "forceCodeSigning": false,
      "signAndEditExecutable": false
    },
    "nsis": {
      "oneClick": true,
      "perMachine": false,
      "createDesktopShortcut": true,
      "createStartMenuShortcut": true,
      "shortcutName": "LingoLearn Phonetics",
      "differentialPackage": true,
      "artifactName": "LingoLearn Phonetics Setup ${version}.${ext}"
    },
    "files": [
      "src/**/*",
      "asset/**/*",
      "package.json"
    ],
    "asarUnpack": [
      "src/windows-asr.ps1",
      "src/capture-selection.ps1",
      "src/selection-watch.ps1",
      "node_modules/@huggingface/transformers/**",
      "node_modules/onnxruntime-web/**"
    ],
    "linux": {
      "target": "AppImage",
      "icon": "asset/icon.png",
      "category": "Education"
    },
    "appx": {
      "identityName": "ANSNEWTECH.LingoLearnPhonetics",
      "publisher": "CN=087A9974-75CB-44FC-B893-8D3999E5E5E5",
      "publisherDisplayName": "ANSNEW TECH.",
      "applicationId": "LingoLearnPhonetics",
      "displayName": "LingoLearn Phonetics",
      "languages": [
        "en-US"
      ]
    }
  },
  "allowScripts": {
    "electron@28.3.3": true
  }
}
